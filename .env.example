# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the root directory of the project:
#    cp .env.example .env
#
# 2. Update the credentials and configurations below with your local values.
#    Do NOT commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Weights & Biases (W&B) Configuration
# ------------------------------------------------------------------------------
# To obtain your W&B API Key:
# 1. Sign up or log in at: https://wandb.ai/
# 2. Retrieve your API key from:    
#
WANDB_API_KEY=your_api_key_here

# W&B Run Mode:
# - 'online'   : Log and sync runs directly to the W&B cloud dashboard (default).
# - 'disabled' : Run the pipeline locally without logging or requiring a key.
WANDB_MODE=online
